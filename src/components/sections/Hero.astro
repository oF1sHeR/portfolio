---
import { site, nav } from '../../data/site';

// Datos reales y verificables. En cuanto uno es inventado, toda la estetica de
// instrumento deja de sostenerse.
const readouts = [
  { key: 'STACK', value: 'PHP · Laravel · WordPress' },
  { key: 'LOC', value: 'España' },
  { key: 'STATUS', value: 'Disponible', live: true },
];
---

<section id="inicio" class="relative min-h-svh w-full overflow-hidden bg-void">
  <div
    class="grid-lines absolute inset-0 opacity-60 [mask-image:radial-gradient(80%_80%_at_40%_50%,#000_25%,transparent_100%)]"
    aria-hidden="true"
  >
  </div>

  <!--
    mix-blend-mode: screen. El shader escribe negro fuera de la figura, y con
    screen el negro es neutro: la reticula sigue viendose detras sin tener que
    pelearse con un contexto WebGL con canal alfa.
  -->
  <canvas
    id="hero-portrait"
    class="absolute inset-y-0 right-0 h-full w-full opacity-70 mix-blend-screen md:w-[58%] md:opacity-100 lg:w-[52%]"
    aria-hidden="true"></canvas>

  <!-- Degradado que funde el retrato con el negro por la izquierda y abajo,
       para que el texto siempre tenga contraste suficiente. -->
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-void)_18%,transparent_62%)] md:bg-[linear-gradient(to_right,var(--color-void)_30%,transparent_72%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-[linear-gradient(to_top,var(--color-void),transparent)]"
    aria-hidden="true"
  >
  </div>

  <header class="relative z-20 pt-6 md:pt-8">
    <div class="container-x flex items-center justify-between gap-6">
      <a href="#inicio" class="label text-fg transition-colors hover:text-signal">RV</a>

      <nav aria-label="Principal">
        <ul class="flex items-center gap-5 md:gap-8">
          {
            nav.slice(1).map((item, index) => (
              <li>
                <a href={item.href} class="label transition-colors hover:text-fg">
                  <span class="text-signal/50">{String(index + 1).padStart(2, '0')}</span>
                  <span class="ml-1.5 hidden sm:inline">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <div class="relative z-10 flex min-h-[calc(100svh-5rem)] items-center">
    <div class="container-x">
      <div class="max-w-2xl">
        <ul class="mb-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-8" data-hero="1">
          {
            readouts.map((item) => (
              <li class="label flex items-center gap-2">
                <span class="text-mute/60">{item.key}</span>
                <span class="text-fg/80">{item.value}</span>
                {item.live && (
                  <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-signal opacity-70" />
                    <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-signal" />
                  </span>
                )}
              </li>
            ))
          }
        </ul>

        <h1
          class="text-[clamp(2.75rem,8.5vw,7rem)] leading-[0.88] font-semibold tracking-[-0.045em] text-balance"
          data-hero="2"
        >
          {site.name}
        </h1>

        <p class="mt-7 max-w-xl text-lg leading-relaxed text-mute text-pretty" data-hero="3">
          Desarrollador web full stack. Levanto webs y tiendas online con PHP,
          Laravel y WordPress, y me encargo también de lo que casi nadie quiere
          tocar: la base de datos y el servidor donde acaban corriendo.
        </p>

        <div class="mt-11 flex flex-wrap items-center gap-4" data-hero="4">
          <a
            href="#proyectos"
            class="group inline-flex items-center gap-3 border border-signal/40 bg-signal/5 px-6 py-3 text-sm text-signal transition-colors hover:bg-signal/12"
          >
            Ver proyectos
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </a>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-3 border border-line px-6 py-3 text-sm text-fg/70 transition-colors hover:border-fg/30 hover:text-fg"
          >
            Escríbeme
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { mountQuad, loadTexture } from '../../scripts/gl';
  import fragmentSource from '../canvas/shaders/portrait.frag.glsl?raw';
  import { site } from '../../data/site';

  // Entrada escalonada. Los elementos parten con opacidad 0 desde CSS para que
  // no parpadeen antes de que GSAP los coja.
  const intro = document.querySelectorAll('[data-hero]');

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.set(intro, { opacity: 1, y: 0 });
  } else {
    gsap.fromTo(
      intro,
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: 1.1, ease: 'expo.out', stagger: 0.09, delay: 0.2 },
    );
  }

  const canvas = document.getElementById('hero-portrait');

  if (canvas instanceof HTMLCanvasElement) {
    let imageAspect = 0.75;

    const renderer = mountQuad(canvas, fragmentSource, {
      maxDpr: 2,
      extraUniforms: ['uImage', 'uImageAspect', 'uParallax', 'uFocusY'],
      revealDuration: 1.8,
      onFrame: ({ gl, at }) => {
        gl.uniform1i(at('uImage'), 0);
        gl.uniform1f(at('uImageAspect'), imageAspect);
        gl.uniform1f(at('uParallax'), 0.055);
        // 1 = anclado en la coronilla. En un retrato vertical metido en un
        // hueco apaisado hay que recortar por abajo, nunca por arriba.
        gl.uniform1f(at('uFocusY'), 1.0);
      },
    });

    // Si la foto no carga, desmontamos: mejor una cabecera tipografica limpia
    // que un rectangulo negro tapando la reticula.
    if (renderer) {
      loadTexture(renderer.gl, site.portrait, 0).then((loaded) => {
        if (!loaded) {
          renderer.destroy();
          canvas.remove();
          return;
        }
        imageAspect = loaded.aspect;
      });
    }
  }
</script>
