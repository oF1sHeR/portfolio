---
import { site, nav } from '../../data/site';

// Datos de la barra superior. Son reales y verificables: la gracia de la
// estetica de instrumento se pierde en cuanto pones metricas inventadas.
const readouts = [
  { key: 'LOC', value: 'España' },
  { key: 'ROLE', value: 'Full stack' },
  { key: 'STATUS', value: 'Disponible', live: true },
];
---

<section id="inicio" class="relative min-h-svh w-full overflow-hidden bg-void">
  <!-- Reticula de fondo, atenuada hacia los bordes. -->
  <div
    class="grid-lines absolute inset-0 opacity-70 [mask-image:radial-gradient(75%_75%_at_50%_45%,#000_30%,transparent_100%)]"
    aria-hidden="true"
  >
  </div>

  <!-- El canvas va detras del texto y desplazado a la derecha: el nombre manda
       en la lectura, la forma acompaña. -->
  <canvas
    id="hero-dither"
    class="absolute top-1/2 right-0 h-[min(92vh,60rem)] w-full max-w-[64rem] -translate-y-1/2 opacity-90 md:right-[-6%] lg:w-[62%]"
    aria-hidden="true"></canvas>

  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-void)_0%,transparent_55%)]"
    aria-hidden="true"
  >
  </div>

  <header class="relative z-20 pt-6 md:pt-8">
    <div class="container-x flex items-center justify-between gap-6">
      <a href="#inicio" class="label text-fg transition-colors hover:text-signal">RV</a>

      <nav aria-label="Principal">
        <ul class="flex items-center gap-5 md:gap-8">
          {
            nav.slice(1).map((item, index) => (
              <li>
                <a href={item.href} class="label transition-colors hover:text-fg">
                  <span class="text-signal/50">{String(index + 1).padStart(2, '0')}</span>
                  <span class="ml-1.5 hidden sm:inline">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <div class="relative z-10 flex min-h-[calc(100svh-5rem)] items-center">
    <div class="container-x">
      <div class="max-w-4xl">
        <ul class="mb-10 flex flex-wrap items-center gap-x-8 gap-y-3" data-hero="1">
          {
            readouts.map((item) => (
              <li class="label flex items-center gap-2">
                <span class="text-mute/60">{item.key}</span>
                <span class="text-fg/80">{item.value}</span>
                {item.live && (
                  <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-signal opacity-70" />
                    <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-signal" />
                  </span>
                )}
              </li>
            ))
          }
        </ul>

        <h1
          class="text-[clamp(3rem,11vw,9rem)] leading-[0.85] font-semibold tracking-[-0.045em] text-balance"
          data-hero="2"
        >
          {site.name}
        </h1>

        <p class="mt-8 max-w-md text-lg leading-relaxed text-mute text-pretty" data-hero="3">
          Desarrollador web. Construyo interfaces rápidas y las llevo hasta
          producción, del shader al despliegue.
        </p>

        <div class="mt-12 flex flex-wrap items-center gap-4" data-hero="4">
          <a
            href="#proyectos"
            class="group inline-flex items-center gap-3 border border-signal/40 bg-signal/5 px-6 py-3 text-sm text-signal transition-colors hover:bg-signal/12"
          >
            Ver proyectos
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </a>
          <a
            href="#contacto"
            class="inline-flex items-center gap-3 border border-line px-6 py-3 text-sm text-fg/70 transition-colors hover:border-fg/30 hover:text-fg"
          >
            Contacto
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { mountQuad } from '../../scripts/gl';
  import fragmentSource from '../canvas/shaders/dither.frag.glsl?raw';

  // Entrada escalonada. Los elementos parten con opacidad 0 desde CSS para que
  // no parpadeen antes de que GSAP los coja.
  const intro = document.querySelectorAll('[data-hero]');

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.set(intro, { opacity: 1, y: 0 });
  } else {
    gsap.fromTo(
      intro,
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: 1.1, ease: 'expo.out', stagger: 0.09, delay: 0.15 },
    );
  }

  const canvas = document.getElementById('hero-dither');

  if (canvas instanceof HTMLCanvasElement) {
    // La trama se calcula en pixeles de dispositivo. Con dpr 1 los puntos
    // quedan del tamaño justo y el raymarching cuesta la mitad: en una trama
    // de 1 bit, bajar resolucion mejora el resultado en vez de empeorarlo.
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);

    mountQuad(canvas, fragmentSource, {
      maxDpr: dpr,
      extraUniforms: ['uDotSize'],
      revealDuration: 1.6,
      onFrame: (renderer) => {
        renderer.gl.uniform1f(renderer.at('uDotSize'), 2.0 * dpr);
      },
    });
  }
</script>
