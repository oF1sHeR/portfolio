---
import Section from '../ui/Section.astro';
import { skills } from '../../data/projects';
---

<Section id="stack" eyebrow="03 — Stack" title="Con qué trabajo">
  <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      skills.map((group) => (
        <div data-reveal>
          <h3 class="mb-4 font-mono text-[0.65rem] tracking-[0.25em] text-signal uppercase">
            {group.group}
          </h3>
          <ul class="space-y-2">
            {group.items.map((item) => (
              <li class="text-fg/70">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
