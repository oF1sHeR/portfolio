---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  class?: string;
}

const { id, eyebrow, title, class: className = '' } = Astro.props;
---

<section id={id} class={`relative border-t border-white/5 py-24 md:py-36 ${className}`}>
  <div class="container-x">
    <header data-reveal class="mb-12 md:mb-20">
      <p class="mb-4 font-mono text-[0.65rem] tracking-[0.3em] text-accent uppercase">
        {eyebrow}
      </p>
      <h2 class="text-balance text-3xl font-semibold tracking-tight md:text-5xl">
        {title}
      </h2>
    </header>

    <slot />
  </div>
</section>
